#optimized caching

def get_user_emails(user_ids):
    if not user_ids:
        return []
    # Single query with IN clause
    placeholders = ",".join(
        "?" * len(user_ids)
    )
    rows = db.query(
        f"SELECT id, email FROM users"
        f" WHERE id IN ({placeholders})",
        *user_ids
    )
    lookup = {r.id: r.email for r in rows}
    return [lookup[i] for i in user_ids]

ids = list(range(1, 1001))
result = get_user_emails(ids)





